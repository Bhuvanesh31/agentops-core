POSTGRES_USER=agentops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentops
POSTGRES_PORT=54325

# Ingestion API
# Host port the API is published on by Docker Compose.
API_PORT=8000
# Host/port the API uses to reach Postgres. Defaults below suit host-based
# development and tests. The Compose "api" service overrides these to reach
# Postgres over the container network (postgres:5432).
POSTGRES_HOST=localhost
